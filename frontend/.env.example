# API provider mode: "mock" (default) or "live"
# mock: use the built-in fixture providers, no backend required
# live: call the backend APIs directly
# Any unset or unrecognized value falls back to "mock".
VITE_API_MODE=mock

# Customer-facing technical metadata is hidden by default.
# Enable only for local debugging; do not enable for the judging demo.
VITE_SHOW_CUSTOMER_TECHNICAL_DETAILS=false

# Vite development proxy target used only when the frontend and backend run separately.
CREDABLE_BACKEND_ORIGIN=http://127.0.0.1:8000
